MP_ACCESS_TOKEN=APP_USR-...   # servidor — DevPanel > sua app > Credenciais > aba Teste (nunca exponha)
MP_WEBHOOK_SECRET=...         # DevPanel > Webhooks > Assinatura secreta (obrigatório para /api/webhooks/mercadopago)
MP_PIX_EXPIRATION=PT30M       # duração ISO 8601 do QR Pix (janela aceita pela MP: 30min–30dias)
APP_URL=                      # deixe vazio em dev local; em produção use https://seudominio.com.br

# Postgres do Supabase — Project Settings > Database > Connection string
DATABASE_URL=postgresql://postgres.<project_ref>:<password>@<pooler-host>:6543/postgres?pgbouncer=true
DIRECT_URL=postgresql://postgres.<project_ref>:<password>@<pooler-host>:5432/postgres
